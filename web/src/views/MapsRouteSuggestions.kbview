<!-- MapsRouteSuggestions - converted from MapsRouteSuggestions.tsx (partial: the per-row glyph is a dynamic
     React <ReactHost> part; the rows - your position, Home/Work shortcuts, recents - are one Repeater). -->
<Panel x:Props="MapsRouteSuggestionsProps" Class="py-1">
  <Stack Direction="LeftToRight" CrossAlign="Center" Visible="{Binding show_error}" Class="gap-1.5 px-6 py-2 text-sm text-danger">
    <Icon Name="AlertCircle" Size="14"/>
    <Label HtmlTag="P" Text="{Binding error}" Overflow="Wrap" InheritFontSize="true"/>
  </Stack>
  <Repeater ItemKey="key" ItemsSource="{Binding rows}">
    <Stack Direction="LeftToRight" CrossAlign="Center" AccessibleRole="PushButton" Class="gap-4 h-16 pl-6 pr-4 cursor-pointer hover:bg-surface-1 outline-none" OnClick="pick">
      <Panel Class="{Binding circle_class}">
        <ReactHost Component="{Binding Icon}" Props="{Binding icon_props}"/>
      </Panel>
      <Stack Gap="0" Class="flex-1 min-w-0">
        <Label HtmlTag="P" Text="{Binding title}" Overflow="Ellipsis" FontWeight="Medium" ForeColor="TextPrimary" Class="text-sm"/>
        <Label HtmlTag="P" Text="{Binding subtitle}" Visible="{Binding show_subtitle}" Overflow="Ellipsis" ForeColor="TextSecondary" Class="text-sm"/>
      </Stack>
      <Icon Name="RefreshCw" Size="18" Visible="{Binding show_busy}" Class="text-text-tertiary animate-spin flex-shrink-0"/>
    </Stack>
  </Repeater>
</Panel>
