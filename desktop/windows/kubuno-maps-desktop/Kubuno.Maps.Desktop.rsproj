<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- The native desktop Maps app for Windows (kubuno-maps.exe): the Win32 window and its views, opened in the
       Visual Studio designer. This file is yours: edit it freely. -->
  <PropertyGroup>
    <CargoPackage>kubuno-maps-desktop</CargoPackage>
    <CargoBin>kubuno-maps</CargoBin>
    <!-- One `cargo build` of the desktop workspace for every project of it (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
  </PropertyGroup>

</Project>
